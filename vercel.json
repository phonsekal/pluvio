{
    "builds": [
        {
            "src": "main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "main.py"
        }
    ],
    "outputDirectory": ".",
    "functions": {
        "main.py": {
            "maxDuration": 30
        }
    }
}
